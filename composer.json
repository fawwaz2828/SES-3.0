{
    "name": "ses/website",
    "description": "SES (Sustain Energy Solution) smart lighting website",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ses\\": "src/"
        },
        "files": [
            "includes/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse --no-progress",
        "rector:check": "vendor/bin/rector process --dry-run",
        "audit": "composer audit --locked",
        "qa": [
            "@cs:check",
            "@phpstan",
            "@rector:check"
        ]
    }
}
